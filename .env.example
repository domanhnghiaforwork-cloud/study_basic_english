# Gemini key from Google AI Studio. Keep the real key in .env only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Answer length, including spaces (100-800). Default: 400 characters.
AI_MAX_RESPONSE_CHARS=400

# Optional: SQLite location, relative to the project root.
STUDY_DB_PATH=storage/study.sqlite
